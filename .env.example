# =============================================================================
# Intelligent DevOps Incident Management System - Environment Configuration
#
# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit your real `.env` file - it is already excluded via .gitignore.
# =============================================================================

# --- OpenAI / LangChain --------------------------------------------------
# If OPENAI_API_KEY is left blank, the system automatically falls back to a
# local MockClassifier that returns randomized severity classifications, so
# the whole stack can run end-to-end without any paid API access.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGCHAIN_TEMPERATURE=0.0

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=incident_db
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://incident_user:change_me@localhost:5432/incident_db

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_LOG_QUEUE=server_log_events

# --- API / App settings ----------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Alerting --------------------------------------------------------------
# Optional webhook (e.g. Slack incoming webhook URL) used by the alerting
# module to notify humans when CRITICAL/INCIDENT events are classified.
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=CRITICAL

# --- Sample data generation -------------------------------------------------
SAMPLE_LOG_COUNT=200
SAMPLE_LOG_DIR=data/sample_logs
